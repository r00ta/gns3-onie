{
  "appliance_id": "b3d8f2a1-4c7e-4e2a-9d1b-7a6c5e4f0a21",
  "name": "ONIE-kvm_x86_64",
  "category": "multilayer_switch",
  "description": "Open Network Install Environment (ONIE) for x86_64, built from the opencomputeproject/onie kvm_x86_64 emulation target. Boots ONIE, then discovers and installs a NOS installer over the network via DHCP/HTTP.",
  "vendor_name": "Open Compute Project",
  "vendor_url": "https://opencomputeproject.github.io/onie/",
  "product_name": "ONIE",
  "product_url": "https://github.com/opencomputeproject/onie",
  "registry_version": 6,
  "status": "stable",
  "maintainer": "onie-gns3 lab",
  "maintainer_email": "noreply@example.com",
  "usage": "Boots ONIE in installer-discovery mode. Provide DHCP + an HTTP-hosted NOS installer on the connected management LAN (see provision/provision-server.sh). ONIE honours DHCP option 114 and probes the DHCP server for onie-installer files. The node has 1 management port (adapter 0 = Management0) and 8 data ports (adapters 1-8 = SONiC Ethernet0/4/.../28). Console is serial over telnet. Default install credentials: ONIE root/onie.",
  "port_name_format": "eth{0}",
  "qemu": {
    "adapter_type": "e1000",
    "adapters": 9,
    "ram": 8192,
    "cpus": 1,
    "hda_disk_interface": "virtio",
    "arch": "x86_64",
    "console_type": "telnet",
    "boot_priority": "c",
    "kvm": "allow",
    "options": "-nographic"
  },
