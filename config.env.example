# -----------------------------------------------------------------------------
# Configuration for the ONIE + SONiC GNS3 switch appliance.
#
# Copy to config.env and adjust for your environment:
#     cp config.env.example config.env
#
# This file is sourced by the shell scripts and parsed by the Python helpers
# (literal KEY=VALUE lines only; values that contain '$' are ignored by the
# Python parser and are only used by the shell scripts).
# -----------------------------------------------------------------------------

# --- GNS3 server API (as seen from the GNS3 host) ----------------------------
GNS3_API=http://localhost:3080/v2
GNS3_PROJECT_NAME=onie-lab

# --- Node names inside the GNS3 project --------------------------------------
GNS3_SERVER_NAME=server        # existing Linux VM used as the provisioning server
GNS3_ONIE_NAME=onie-switch     # the ONIE appliance node
GNS3_PC1_NAME=PC1              # test host on data port 1
GNS3_PC2_NAME=PC2              # test host on data port 2

# --- Paths on the GNS3 host --------------------------------------------------
ONIE_WORKDIR=$HOME/onie-build
ONIE_SRC=$ONIE_WORKDIR/onie
GNS3_IMAGE_DIR=/opt/gns3/images/QEMU

# --- ONIE build target -------------------------------------------------------
ONIE_MACHINE=kvm_x86_64
ONIE_ARCH=x86_64

# --- Appliance sizing --------------------------------------------------------
# SONiC requests a 32 GiB SONiC-OS partition, so the disk must be >= ~34 GiB.
# SONiC-vs runs ~40 containers and needs >= 8 GiB RAM to boot cleanly.
APPLIANCE_DISK_SIZE=40G
APPLIANCE_RAM=8192             # MB
APPLIANCE_ADAPTERS=9           # 1 management + 8 data ports
APPLIANCE_NIC=e1000

# --- Provisioning network (server VM LAN interface) --------------------------
LAN_IP=172.31.0.1
LAN_CIDR=24
DHCP_FROM=172.31.0.50
DHCP_TO=172.31.0.150

# --- Server VM SSH (reached over the GNS3 NAT network) -----------------------
SERVER_SSH_USER=ubuntu
SERVER_SSH_PASS=ubuntu
# The server IP is auto-detected from the GNS3 NAT (libvirt) DHCP leases. When
# several project VMs share that bridge the guess can be wrong; pin it by
# exporting SERVER_IP (e.g. `SERVER_IP=192.168.122.214 bash provision/provision-server.sh`).
# SERVER_IP=

# --- SONiC source image ------------------------------------------------------
# Path on the GNS3 host to the direct-boot sonic-vs disk image you provide.
SONIC_IMG=$ONIE_WORKDIR/sonic-vs.img

# --- SONiC default credentials (used by the VLAN test driver) ----------------
SONIC_USER=admin
SONIC_PASS=YourPaSsWoRd

# --- VLAN validation ---------------------------------------------------------
TEST_VLAN=10
PC1_IP=192.168.50.10
PC2_IP=192.168.50.20
TEST_NETMASK=255.255.255.0
